{
  "name": "papertrade-india",
  "private": true,
  "version": "1.0.0",
  "description": "Educational Indian Stock Market Simulator — 100% virtual, zero real money",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
